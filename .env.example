# ==============================================================================
# ScheduleManager Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   Development: docker compose up -d
#   Production:  docker compose -f docker-compose.prod.yml up -d
# ==============================================================================

# ==============================================================================
# 1. Reverse Proxy & Domain Configuration (Production Caddy)
# ==============================================================================
# In production, set DOMAIN_NAME to your public domain (e.g. schedule.example.com).
# Caddy will automatically issue and renew TLS certificates from Let's Encrypt / ZeroSSL.
# Leave as :80 for local production simulation or internal IP access.
DOMAIN_NAME=:80

# Production CORS Allowlist (comma-separated origins allowed to make cross-origin requests).
# Leave empty if frontend and backend are served from the same unified Caddy domain.
# Example: CORS_ORIGINS=https://schedule.example.com
CORS_ORIGINS=

# ==============================================================================
# 1.5 Ingress HTTP Basic Authentication (Public Access Barrier)
# ==============================================================================
# In production, the entire application is protected behind Caddy HTTP Basic Auth.
# Credentials are never hardcoded in repository files.
# Generate the password hash securely using Docker/Caddy on the Azure VM:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_STRONG_PASSWORD' | tr -d '\r\n' | base64
#
# Set the administrator username and the resulting base64-encoded bcrypt hash below:
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=CHANGE_ME_TO_BASE64_HASH_FROM_CADDY

# ==============================================================================
# 2. PostgreSQL Configuration
# ==============================================================================
# WARNING: In production, generate strong, distinct credentials. Never use 'postgres/postgres'.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
POSTGRES_DB=primavera

# ==============================================================================
# 3. MinIO Object Storage Configuration
# ==============================================================================
# WARNING: In production, generate strong, distinct credentials. Never use 'minioadmin/minioadmin'.
MINIO_ROOT_USER=minio_admin_user
MINIO_ROOT_PASSWORD=CHANGE_ME_TO_STRONG_MINIO_PASSWORD
MINIO_BUCKET=sih-artifacts

# ==============================================================================
# 4. Service Ports & Internal Networking (Development Compose only)
# ==============================================================================
# In production Compose (docker-compose.prod.yml), only Caddy ports 80/443 are exposed.
# In development Compose (docker-compose.yml), the backend is accessible at BACKEND_PORT.
BACKEND_PORT=8080
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME_TO_STRONG_PASSWORD@postgres:5432/primavera
PARSER_URL=http://document-parser:8001

# ==============================================================================
# 5. External AI Credentials & Models (Dedicated & Isolated per Service)
# ==============================================================================
# Time Agent LLM Configuration (Dedicated Key & Model)
TIME_AGENT_GEMINI_API_KEY=
TIME_AGENT_LLM_MODEL=gemini-2.5-flash

# Artifact Document Extraction LLM Configuration (Dedicated Key & Model)
EXTRACTION_GEMINI_API_KEY=
EXTRACTION_LLM_MODEL=gemini-3.5-flash

# Sarvam AI Configuration (Multilingual STT Saaras v4, Language Detection & Translation)
SARVAM_API_KEY=

# ==============================================================================
# 6. Legacy LLM Fallback (Backward-Compatibility Only - Disabled in Production)
# ==============================================================================
ALLOW_LEGACY_GEMINI_FALLBACK=false
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-3.5-flash

# ==============================================================================
# 7. Frontend Build & API Routing
# ==============================================================================
# In production, leave empty or unset so the client automatically routes via Caddy.
# In standalone local development, defaults to http://localhost:8080.
NEXT_PUBLIC_API_URL=
