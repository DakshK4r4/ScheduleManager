# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=primavera

# Backend Configuration
BACKEND_PORT=8080
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/primavera
PARSER_URL=http://document-parser:8001

# ==============================================================================
# Primary LLM Credentials & Models (Dedicated & Isolated per Service)
# ==============================================================================
# Time Agent LLM Configuration (Dedicated Key & Model)
TIME_AGENT_GEMINI_API_KEY=
TIME_AGENT_LLM_MODEL=gemini-2.5-flash

# Artifact Document Extraction LLM Configuration (Dedicated Key & Model)
EXTRACTION_GEMINI_API_KEY=
EXTRACTION_LLM_MODEL=gemini-3.5-flash

# Sarvam AI Configuration (Multilingual STT Saaras v4, Language Detection & Translation)
SARVAM_API_KEY=

# ==============================================================================
# Legacy LLM Fallback (TEMPORARY BACKWARD-COMPATIBILITY ONLY - NOT FOR PRODUCTION)
# ==============================================================================
# Shared GEMINI_API_KEY is a temporary backward-compatibility mechanism only.
# In production (ENVIRONMENT=production), automatic fallback to GEMINI_API_KEY
# is strictly disabled unless explicitly enabled via ALLOW_LEGACY_GEMINI_FALLBACK=true.
ALLOW_LEGACY_GEMINI_FALLBACK=true
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-3.5-flash

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8080
